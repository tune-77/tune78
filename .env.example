# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ALPACA TRADING API (For US Stocks & ETFs)
# Obtain these from https://alpaca.markets/
ALPACA_API_KEY="your_alpaca_api_key_here"
ALPACA_SECRET_KEY="your_alpaca_secret_key_here"
ALPACA_PAPER="true" # Set to 'false' for live trading, 'true' for paper trading

# au KABUCOM KABUSTATION API (For Japanese Stocks)
# Obtain API Password and Port from kabu Station API settings
KABUCOM_API_PASSWORD="your_kabucom_api_password_here"
KABUCOM_BASE_URL="http://localhost:18081/kabucom/api" # Default kabuStation local endpoint

